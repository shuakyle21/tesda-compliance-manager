  "claims": [
    {
      "id": "claim_ec1d458339104b2bb45845651a92581b",
      "statement": "The report route resolves the school and membership contract first, then gates on `resolveTrustedRole` over `profiles.role` (never `resolveRouteRole`, whose `?role=` override would bypass it) and redirects a trainer to `/trainer` before either the batch or the roster fetch. When the profile snapshot is not `ok` — or there is no Clerk user id — the derived role is null, so the gate is skipped and the page runs on rather than denying.",
      "evidence": [
        {
          "resource": "repo://app/(dashboard)/t/%5BtenantCode%5D/(sections)/report/page.tsx#L49-L58",
          "version": "repo-lines-v1:sha256:22385b4f098cb83c975f38e27262fa5b7d87c28288d40d00103db6c907a0dc09:"
        },
        {
