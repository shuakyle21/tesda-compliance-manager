          "version": "repo-lines-v1:sha256:898f65234affb7001495674d65afcf3c51b5792e447bec0564459f19c8c5cdf9:"
        }
      ]
    },
    {
      "id": "claim_b66a92d8477345b8b0348a477f5aa6cd",
      "statement": "The create-user action resolves the caller's role with `resolveTrustedRole` rather than `resolveRouteRole` because the latter honours a `?role=` query override and the Clerk invitation branch has no RLS behind it to fall back on.",
      "evidence": [
        {
          "resource": "repo://app/(dashboard)/users/new/actions.ts#L71-L75",
          "version": "repo-lines-v1:sha256:fd7bc8cd5d9cbd40955e7966177b0a29ed3222f8e6a6606c9a6612e5b88db91f:"
