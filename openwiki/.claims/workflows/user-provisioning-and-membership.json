        }
      ]
    },
    {
      "id": "claim_bbdf188971d9458dbbd28cb5333e8dda",
      "statement": "Invitation metadata is trusted because `publicMetadata` is writable only through the Clerk Backend API, so the grant arrives with the inviting admin's authority rather than the new user's; it is the one narrow exception to provisioning never granting tenant access.",
      "evidence": [
        {
          "resource": "repo://app/api/webhooks/clerk/route.ts#L33-L38",
          "version": "repo-lines-v1:sha256:dda0203171e4fe9a9f0d4084c1a78092e4d446f10daf0029f03b7b294451e7ae:"
        },
        {
