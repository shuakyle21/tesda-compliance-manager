  "claims": [
    {
      "id": "claim_3dec0b941769449991349e1035245b1f",
      "statement": "No profile row can exist before the person has a Clerk account because `profiles.clerk_user_id` is `not null unique`, so an admin inviting a stranger has nothing in Postgres to write a role onto and the grant must be parked on the Clerk invitation until acceptance.",
      "evidence": [
        {
          "resource": "repo://modules/auth/domain/invitationMetadata.ts#L4-L16",
          "version": "repo-lines-v1:sha256:e760d88b943f75a382d696624292177bbc3aaafd520e38d4099bfa6ee714743e:"
