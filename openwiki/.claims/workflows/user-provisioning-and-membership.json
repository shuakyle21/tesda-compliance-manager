        }
      ]
    },
    {
      "id": "claim_26487fd9af3341e09de3ae84e4a50b73",
      "statement": "`user.deleted` deactivates rather than hard-deleting because deactivation stops authorization through `current_profile_id()`'s `is_active = true` filter while preserving memberships and the profile references that batch, document and activity history rely on.",
