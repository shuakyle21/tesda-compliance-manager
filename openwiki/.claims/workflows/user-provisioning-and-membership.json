        }
      ]
    },
    {
      "id": "claim_a816a58904ae4d5592884acea5bb9aaa",
      "statement": "`assignUserAccess` resolves its target by email, so the email lookup is an access-control decision: `%`, `_` and `\\` are escaped for ILIKE and the match is re-confirmed by normalized exact equality, because PostgREST rewrites `*` to `%` before Postgres can escape it.",
      "evidence": [
        {
          "resource": "repo://modules/tenancy/data/users.ts#L147-L177",
          "version": "repo-lines-v1:sha256:640057b00caa04351af52c47460fb1ee0331c6ee9dac0481e0c080ad50210240:"
