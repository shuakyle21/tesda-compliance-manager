        }
      ]
    },
    {
      "id": "claim_59d33fc6fc21418eb1a65294e7bc66a3",
      "statement": "The platform admin can seat a tenant's first member but never itself: the seating policy requires `profile_id <> current_profile_id()` and a tenant with no memberships, and both predicates are load-bearing — the first closes the self-escalation, and it holds even when the second is racy under concurrent inserts.",
      "evidence": [
        {
          "resource": "repo://docs/adr/ADR-006-platform-admin-and-school-registry.md#L103-L125",
          "version": "repo-lines-v1:sha256:7ef17516925f79b36e256c3bb80396bcd25356ec66a5822e2b6d3f53b0582fd8:"
        },
        {
