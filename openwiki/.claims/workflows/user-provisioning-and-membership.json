          "version": "repo-lines-v1:sha256:8d5c38fba95388f6083dae662cac5b20625e2b145507997222054c9d17023e43:"
        }
      ]
    },
    {
      "id": "claim_a4dba067f03647b9a4c25cf0d4c3427b",
      "statement": "An invitation for an address that already has an account or a pending invitation is reported as `duplicate` instead of being created, because two live invitations carrying different grants would let which email the person opens decide their access.",
      "evidence": [
        {
          "resource": "repo://modules/auth/data/invitations.ts#L38-L83",
          "version": "repo-lines-v1:sha256:f7014f3bf41f4020d6e8fe1656a41add5b2ba20b556fda4f614354b62e40d3c5:"
        },
