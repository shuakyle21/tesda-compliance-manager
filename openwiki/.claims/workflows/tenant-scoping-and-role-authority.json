    {
      "id": "claim_243622bb327d49be960da592d1564619",
      "statement": "`getSignedInProfile` and `resolveRouteScope` are `cache()`-wrapped so the `/t/[tenantCode]` layout and its page share one `getProfileSnapshot` read per request; the underlying profile query is itself `cache()`d by `clerkUserId`, and `cache()` is per-request, so the wrapper dedupes rather than caches stale data.",
      "evidence": [
        {
          "resource": "repo://app/(dashboard)/tenant-scope.ts#L11-L12",
          "version": "repo-lines-v1:sha256:038a7ecea3654828d88a6dc85a14f85d267e6623e336e8888f9c1abd2635f749:"
