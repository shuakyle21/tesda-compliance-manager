    {
      "id": "claim_b513981831424c8d9bdd5f16978c9733",
      "statement": "`resolveRouteScope` has four arms — `ok`, `not-a-member`, `no-tenant-access`, `unknown` — and only `ok` yields a `TenantScope`; the segment layout renders the other three, and a foreign code never falls back to 'all schools'.",
      "evidence": [
        {
          "resource": "repo://app/(dashboard)/t/%5BtenantCode%5D/layout.tsx#L28-L49",
          "version": "repo-lines-v1:sha256:c0e852a02842f9129b0b4d47c7bd0b24ec54642f48497563b25dc313f855d0e9:"
