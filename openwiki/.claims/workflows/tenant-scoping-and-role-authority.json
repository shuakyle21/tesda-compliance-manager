    {
      "id": "claim_9bcfc61c962642fc9ae64bb2a5de8129",
      "statement": "`getSignedInProfile` collapses a failed identity read or any non-`ok` snapshot other than `not-found` to `'unknown'`, and `not-found` to `'none'`; `resolveRouteScope` checks `'unknown'` before `'none'` so 'we could not check' never renders as 'never assigned a school'.",
      "evidence": [
        {
          "resource": "repo://app/(dashboard)/tenant-scope.ts#L37-L49",
          "version": "repo-lines-v1:sha256:19ae4914ac857c0056fe4f168ef26bf4e9777c1f07e769417dde7f3e0c27be91:"
