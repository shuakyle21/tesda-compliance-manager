    {
      "id": "claim_922158d8d55c4aa0b1190010191252ce",
      "statement": "POST /api/webhooks/clerk is deliberately unauthenticated because no session exists when Clerk calls; it proves the request by verifying Clerk's signature with verifyWebhook against CLERK_WEBHOOK_SIGNING_SECRET and answers 400 'Verification failed' without writing anything when verification fails.",
      "evidence": [
        {
          "resource": "repo://app/api/webhooks/clerk/route.ts#L8-L26",
          "version": "repo-lines-v1:sha256:9a015db57e3bb0f19b955fffeb69e934b2f8a5a829e52246eb78dab2fe8b4bca:"
        }
      ]
    },
    {
      "id": "claim_44a6030d996c48fb8cc7a2a743c6f569",
      "statement": "A verified webhook is still not a session: the delivery proves only that Clerk sent the body, carries no Supabase identity, and arrives for user.created before the profiles row exists and for user.deleted after the identity is gone — which is why the write path must run as service_role.",
      "evidence": [
        {
          "resource": "repo://app/api/webhooks/clerk/route.ts#L19-L45",
          "version": "repo-lines-v1:sha256:52b56a25582045df170cbe957df92de219054fc7901b7afbb64a589948c2830b:"
