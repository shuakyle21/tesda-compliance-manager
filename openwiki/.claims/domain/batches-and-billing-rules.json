    {
      "id": "claim_5d380d4e36b841ea8681616649f7c656",
      "statement": "The batch pipeline is AOU → NTP → TIP → Training → Assessment → Billing (with the UI-only `entre` key), but the lifecycle is a display contract, not stored history: a mapper expands the single `current_stage` enum into done/active/pending so per-stage dates are blank until activity_log is joined.",
      "evidence": [
        {
          "resource": "repo://modules/batches/data/batches.ts#L146-L193",
