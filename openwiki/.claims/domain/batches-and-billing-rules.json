    {
      "id": "claim_25fb2ebc2bc24c48b99a608000a17e1d",
      "statement": "Progress is attendance-derived: the mapper counts distinct attended dates and returns `completedSessions = null` unless both a snapshotted `total_sessions` and at least one attendance row exist, because PostgREST's empty embed `[]` means unrecorded rather than zero; `sessionProgress` propagates the null and the dashboard mean filters to tracked batches so an untracked portfolio reads null.",
      "evidence": [
        {
          "resource": "repo://modules/batches/data/batches.ts#L105-L123",
