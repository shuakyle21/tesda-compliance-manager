    {
      "id": "claim_f10888b95ea24b0c82f72916673363a8",
      "statement": "`session_exists` — Clerk's 400 when a sign-in is started while the browser already holds a session — is handled by `isSessionExistsError` scanning `errors[]` for that code and returning false for a bare `Error`, `null` or an empty array; the sign-in card checks it at six handlers (password, MFA, device verification, Google SSO, account create, submit) and each calls `continueExistingSession()` instead of showing an error, so a user who is in fact signed in is never blocked by a red card.",
      "evidence": [
        {
          "resource": "repo://app/sign-in/%5B%5B...sign-in%5D%5D/sign-in-page.tsx#L99-L228",
          "version": "repo-lines-v1:sha256:324ee9fac9ea30748133bad99905896c5d7d00bf3525995fbb7021643b92d117:"
        },
        {
          "resource": "repo://modules/auth/domain/sessionExists.ts#L9-L12",
          "version": "repo-lines-v1:sha256:0dde28b5d8fc345be4a32d2bd7cb4e59927f8551ddf1d4cf0599fe0ad763781c:"
        },
        {
