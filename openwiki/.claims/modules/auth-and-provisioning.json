    },
    {
      "id": "claim_7c12cf183ba24c128a77734f94cbd289",
      "statement": "`requireAuthenticatedUser()` lives in `modules/auth/data/auth.ts` — a `data/` layer that is private to its module — so only `app/` may call it, and the only two callers are the `(dashboard)` layout's first statement and `app/api-docs/page.tsx`, which sits outside the route group; a route outside `(dashboard)` stays unauthenticated until it adds its own call.",
      "evidence": [
        {
          "resource": "repo://app/(dashboard)/layout.tsx#L12-L13",
          "version": "repo-lines-v1:sha256:03a2a7eb120ac2eb659e2270c1c55ce88c159ad78399bcc67c3ed3760240e099:"
