          "version": "repo-file-v1:sha256:9379a90ff525e4116f99695a66c82ceb8e12d2b62ccb9495ef9fa8411ad6b6d1"
        }
      ]
    },
    {
      "id": "claim_d4e0fbd774ce4d129aacd17b286bdf66",
      "statement": "`startGoogleSignIn` must await a `reset()` before calling `sso()` whenever `signIn.status` is non-null, because `sso()` silently declines to start an attempt when it sees a stale status and surfaces no error; the unit test models `status` as a mutable field cleared only when the delayed `reset()` resolves, so an un-awaited reset fails the test the way it failed in production.",
      "evidence": [
        {
          "resource": "repo://modules/auth/domain/oauthSignIn.ts#L20-L39",
          "version": "repo-lines-v1:sha256:f998d9ffba2990ac582d47f254f5d09acf9b99a819d409f1b54da37602be0d95:"
        },
