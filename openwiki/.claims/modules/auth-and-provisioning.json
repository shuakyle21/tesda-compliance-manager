    {
      "id": "claim_45f9afcc5db94bf2b20613f403917d29",
      "statement": "A signed-in user with no `profiles` row has no role: `getAuthUserId()` still returns an id and an inactive profile still resolves for the layout, but `current_profile_id()` returns NULL so every RLS predicate fails and reads return zero rows — which is why deactivation is not a sign-out and why a fresh sign-up reads as an empty dashboard.",
      "evidence": [
        {
          "resource": "repo://modules/auth/data/auth.ts#L9-L22",
          "version": "repo-lines-v1:sha256:0d361974614b714bdbd4abd28c58a4267882c244543f019216c8c4bf4d7c9b6d:"
