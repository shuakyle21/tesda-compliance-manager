    {
      "id": "claim_22a949120d3740e686590c9a89a48a6c",
      "statement": "`app/api/webhooks/clerk/route.ts` has no session to check because Clerk is the caller, so it authenticates the request by verifying the body signature with Clerk's `verifyWebhook()` against `CLERK_WEBHOOK_SIGNING_SECRET` and answers 400 on failure; no `proxy.ts` exclusion is necessary because the middleware matcher already covers `/api(.*)` and only stamps `x-pathname`.",
      "evidence": [
        {
          "resource": "repo://app/api/webhooks/clerk/route.ts#L8-L26",
          "version": "repo-lines-v1:sha256:9a015db57e3bb0f19b955fffeb69e934b2f8a5a829e52246eb78dab2fe8b4bca:"
