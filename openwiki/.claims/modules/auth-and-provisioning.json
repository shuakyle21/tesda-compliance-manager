    {
      "id": "claim_6c58a22185b94707a70c9ee141494d01",
      "statement": "`sanitizeRedirectUrl` closes the open-redirect failure — signing in against the real app and then being handed to an attacker's site — by rejecting every form the browser resolves off-site: an absolute URL, a protocol-relative `//host`, a backslash after the leading slash, and a `javascript:`/`data:` scheme; the sanitized value is both the signed-in destination and the `redirectUrl` given to Clerk's OAuth start, so there is one place to get it right.",
      "evidence": [
        {
          "resource": "repo://app/sign-in/%5B%5B...sign-in%5D%5D/sign-in-page.tsx#L100-L100",
          "version": "repo-lines-v1:sha256:fba19c43f2288e0e17bdbe8f1aacb84c88a53ee122adf4af7bffa7fa0e1acc7f:"
        },
        {
