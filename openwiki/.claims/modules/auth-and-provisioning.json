          "version": "repo-lines-v1:sha256:a08462d924ef40243eb6c81fb48ccdb483abea7f66e19fb595609b9c0e0a3772:"
        }
      ]
    },
    {
      "id": "claim_bc0b5b8548ac437599ff36c5fefd506e",
      "statement": "The invitation membership split narrows the never-re-grant invariant rather than holding it whole: `upsertProfileFromClerkUser` calls `ensureTenantMembership` on the update path too, so a membership is written only when the profile holds none — a grant can never add a second school or move someone an admin has already placed, while an admin authoring a grant onto an existing tenantless user through Clerk's Backend API is applied at the next delivery.",
      "evidence": [
        {
          "resource": "repo://modules/auth/data/provisioning.ts#L44-L105",
          "version": "repo-lines-v1:sha256:bfc5908d809fe1be993fee05624831e9c3e3388faf3646f1b9e5a6f870cb7824:"
        }
      ]
    },
    {
