    {
      "id": "claim_bdc9949780b5495d80a536807d660abd",
      "statement": "The report route folds the membership verdict into the batch snapshot with `withTenantAccess`, deriving it from the profile snapshot the trainer redirect already fetched rather than re-fetching; `withTenantAccess` rewrites only an `ok` snapshot, so a real fetch failure is never masked by \"you belong to no school\".",
      "evidence": [
        {
          "resource": "repo://app/(dashboard)/t/%5BtenantCode%5D/(sections)/report/page.tsx#L60-L65",
          "version": "repo-lines-v1:sha256:9058f8f9eccc9363db154eb6243b7b74ccc6d0476791e1e6dd0571e36f0d42a2:"
