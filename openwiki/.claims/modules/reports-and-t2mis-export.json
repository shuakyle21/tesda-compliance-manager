  "claims": [
    {
      "id": "claim_3da86a224c694356bf364986c8531316",
      "statement": "The T2MIS export splits the workbook across two modules: the 48-column layout and `buildT2misRows` live in `modules/import-export/domain/t2mis.ts`, while the XLSX writer `buildXlsx` lives in `modules/reports/domain/xlsx.ts` and is wrapped by `modules/reports/ui/exportXlsx.ts` — a cross-module `domain/` import that rule 8 permits and a `data/`-to-`data/` import would block.",
      "evidence": [
        {
          "resource": "repo://RULES.md#L37-L49",
          "version": "repo-lines-v1:sha256:f52f861a21ed2ba64f7d9ec13151eff8e404e5dbae68b620b32604bef6cefcc9:"
        },
        {
          "resource": "repo://modules/import-export/domain/t2mis.ts#L1-L20",
          "version": "repo-lines-v1:sha256:10ca2542f9026046300b459744b232d822f6a5fc46758973a56eec658927dc1f:"
