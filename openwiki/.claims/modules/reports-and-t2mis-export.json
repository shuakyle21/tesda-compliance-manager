    {
      "id": "claim_a05d54ed2071403ab82a19344b4906f1",
      "statement": "The report route redirects a trainer to `/trainer` on `resolveTrustedRole` (profiles.role only) before any fetch, deliberately never on `resolveRouteRole`, whose `?role=` preview override would let a real trainer request `?role=admin` and skip the redirect.",
      "evidence": [
        {
          "resource": "repo://app/(dashboard)/t/%5BtenantCode%5D/(sections)/report/page.tsx#L40-L58",
          "version": "repo-lines-v1:sha256:e19a65b3b02732af071c2f9ea6af719e86565ff60b0ab6be92aaa8d41b4f8004:"
