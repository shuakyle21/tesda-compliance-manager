    },
    {
      "id": "claim_e297bfa8321540bbb85d22cf8603c8d2",
      "statement": "The report route combines the batch snapshot and the separate roster snapshot into one `syncFailed` flag that renders a warning callout with a Retry link above both the empty branch and the populated report, so a failed roster still renders a possibly incomplete report instead of being swallowed by the empty branch.",
      "evidence": [
        {
          "resource": "repo://RULES.md#L63-L67",
          "version": "repo-lines-v1:sha256:f86d9c6163383682e63bbf31a1ca3b9b684ce38d45ec1007d2138454bd8cb182:"
