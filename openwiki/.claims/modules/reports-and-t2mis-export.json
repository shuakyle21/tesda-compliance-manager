    {
      "id": "claim_432fca349bd245f996a32d98b059a74e",
      "statement": "Every roster cell goes through `orEmpty`, so a null and an absent `learner_details` row (RLS-withheld, no details row yet, or a pre-migration schema) both blank to `''`; blanks only mean \"not recorded\" when the query succeeded, which is why the route shows the sync-failed warning while still rendering.",
      "evidence": [
        {
          "resource": "repo://app/(dashboard)/t/%5BtenantCode%5D/(sections)/report/page.tsx#L73-L81",
          "version": "repo-lines-v1:sha256:eefaa33671ee7a8c95a491ac87f93a38707f2afee8759d1c895c4e484a05918d:"
