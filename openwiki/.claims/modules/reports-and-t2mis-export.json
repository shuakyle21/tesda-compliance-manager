          "version": "repo-lines-v1:sha256:44ff0dbcc7f4f80d76387f4b815b9142746c06c63ecb5d9fc8d607d02362f267:"
        }
      ]
    },
    {
      "id": "claim_a3131932be3e46f5b1f6ee64323ee0b8",
      "statement": "Producing the report file is not a submission — TESDA SIS/T2MIS/BSRS stay authoritative (rule 27) — so the export builds a working .xlsx that the browser downloads and no copy claims the report was filed.",
