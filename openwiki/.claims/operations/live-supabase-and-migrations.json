    {
      "id": "claim_7d72973f1129444c9280b4243aa15dfd",
      "statement": "Repair-recording — verifying an already-hand-applied migration's objects live and then inserting its version rather than re-running the file — is the ledger's documented compromise for drift: it records that objects match, not that the file reproduces them from scratch, and `20261111120000` was recorded that way after its objects were found live and an idempotent script (re)created the policies, trigger and indexes.",
      "evidence": [
        {
          "resource": "repo://supabase/migrations/20261111120000_add_t2mis_terminal_report_fields.sql#L1-L6",
          "version": "repo-lines-v1:sha256:b9f36e768a4f1937fd7824239a6b73011f2dce11cdda805685db27546c956340:"
        },
        {
