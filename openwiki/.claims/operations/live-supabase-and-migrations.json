    {
      "id": "claim_6df5e6eec4ee478095b76f80721fd4c4",
      "statement": "Rule 36 draws its line at the tool rather than the statement kind: `execute_sql` is denied even for a read-only `select`, while `list_tables`, `list_migrations`, `get_advisors` and `search_docs` stay available, and the rule's own prescribed order is to answer schema questions from the checked-in migrations and `lib/supabase/database.types.ts` first.",
      "evidence": [
        {
          "resource": "repo://RULES.md#L132-L144",
          "version": "repo-lines-v1:sha256:c3f3586b978a1f38167bd8e4b8d648ccabb7e1752af42d4de251ba6dd007ac6a:"
