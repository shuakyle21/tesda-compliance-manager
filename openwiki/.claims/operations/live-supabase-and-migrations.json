    {
      "id": "claim_4b8f247b300240a79cadb7385008fc0d",
      "statement": "`SUPABASE_SERVICE_ROLE_KEY` is read only by `lib/supabase/service.ts` and must never be `NEXT_PUBLIC_`, so every non-service-role path carries the Clerk session token on the anon key and leaves authorization to RLS; `.env.example`, by contrast, documents only the Clerk `pk_test_*`/`sk_test_*` pair and the Playwright user.",
      "evidence": [
        {
          "resource": "repo://.env.example#L1-L9",
