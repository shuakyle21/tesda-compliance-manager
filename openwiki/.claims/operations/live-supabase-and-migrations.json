    {
      "id": "claim_1090f681b531453080e48d31ee2a12d2",
      "statement": "`RULES.md` rule 36 (`[deny]`) is enforced by a session-wide `.claude/settings.json` `permissions.deny` list that names the Supabase MCP mutation tools in both plain and instance-id-prefixed spellings, the CLI routes `db push`/`db reset`/`migration up` under both `supabase` and `npx supabase`, and `Bash(psql:*)` — so no in-session exception can be requested, and only editing the settings file lifts a deny.",
      "evidence": [
        {
          "resource": "repo://.claude/settings.json#L6-L36",
          "version": "repo-lines-v1:sha256:e00c00482fda63d738391a84b9d3b1d7350ed0edb6d7489d770671c6c47b9ff2:"
