    {
      "id": "claim_a1ca72cf1b5c4ef8a429a6cf59d3f096",
      "statement": "Rule 36 is enforced as a `permissions.deny` entry in `.claude/settings.json`, naming each entry point under both the bare and instance-id-prefixed MCP spellings (`execute_sql`, `apply_migration`, `deploy_edge_function`, all branch operations including rebase, `db push`, `db reset`, `migration up` under both `supabase` and `npx supabase`, and `psql`); because it is a deny rather than a prompt, an agent cannot ask for an exception mid-session and lifting it means editing the file.",
      "evidence": [
        {
          "resource": "repo://.claude/settings.json#L6-L31",
          "version": "repo-lines-v1:sha256:7c4ae3fde9b00ef978349cd813df5c162d1c12774fb92a07df50248e30554cdc:"
