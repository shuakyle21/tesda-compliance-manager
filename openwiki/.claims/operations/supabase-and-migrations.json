    {
      "id": "claim_358521ea07a04561b3d4948347d36a42",
      "statement": "The repo has exactly one hosted Supabase project and no staging; `.mcp.json` pins its MCP server to that single project ref, so every migration is written against the only data that exists.",
      "evidence": [
        {
          "resource": "repo://.mcp.json#L1-L8",
