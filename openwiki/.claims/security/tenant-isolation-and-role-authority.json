        }
      ]
    },
    {
      "id": "claim_3c4dc73a1a0045bfa9dcb2ba61ff7650",
      "statement": "`withTenantAccess` rewrites only an `ok` snapshot: a `sync-failed` passes through untouched so \"you belong to no school\" never buries a real fetch failure, and `unknown` never rewrites a successful read.",
      "evidence": [
        {
          "resource": "repo://modules/tenancy/domain/access.ts#L41-L58",
          "version": "repo-lines-v1:sha256:dd47815b8ecdfceafab19d7d52868cac29613de46d7128fb571d2ef2c9417c92:"
