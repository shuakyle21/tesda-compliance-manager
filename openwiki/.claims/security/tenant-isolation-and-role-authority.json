    {
      "id": "claim_5bfcd147e0b449138e507751b8592c4f",
      "statement": "`profiles.role` is the only role authority: `resolveTrustedRole` reads nothing else and resolves null when there is no profile row (Clerk is identity only, after audit I5 rendered one admin as ADMIN and VIEWER simultaneously). `resolveRouteRole`/`resolveDisplayRole` put the unauthenticated `?role=` preview first, and `toOfficeRole` narrows anything non-office to read-only viewer — so a redirect gated on the override lets a real trainer request `?role=admin` and skip the office gate.",
      "evidence": [
        {
          "resource": "repo://modules/auth/data/role.ts#L45-L114",
          "version": "repo-lines-v1:sha256:0c4c92b864fc08a84f3ab808d5281e95e2a4b8a2e03a92144a8fdf7cd6b6b726:"
