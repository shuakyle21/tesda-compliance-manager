# Clerk E2E testing (Playwright) — see .claude/skills/clerk-testing
# Use pk_test_*/sk_test_* keys only, never production keys.
CLERK_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
CLERK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Existing Clerk test user (create one manually in the Clerk test instance,
# or via the Backend API) used by tests that need a signed-in session.
E2E_CLERK_USER_EMAIL=e2e-user+clerk_test@example.com
E2E_CLERK_USER_PASSWORD=change-me
